# Environment Variables for Next Starter — copy to .env and fill in
# Validated at boot in src/lib/env.ts (Zod). Missing/invalid required vars throw.
# Required vars must be non-empty valid values; optional may be "" or omitted.

# ── Database (required) ──────────────────────────────────────────────
# Neon PostgreSQL — must be a valid URL (postgresql://...)
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── Auth (required) ──────────────────────────────────────────────────
# At least 32 chars — used as Better Auth secret
BETTER_AUTH_SECRET="replace-with-32-char-random-string-min-length-32"
# Base URL of the app — must be a valid URL, no trailing slash auto-trimmed. Use http://localhost:3000 for dev.
BETTER_AUTH_URL="http://localhost:3000"

# ── Email (required: EMAIL_FROM + at least one of NODEMAILER_EMAIL/PASSWORD) ─
# Display From address — must be a valid email
EMAIL_FROM="noreply@yourdomain.com"
# SMTP auth user — valid email or "" (optional, falls back to EMAIL_FROM in src/lib/env.ts:84)
NODEMAILER_EMAIL="noreply@yourdomain.com"
# Gmail app password — string min 1 char or "" (optional but one of EMAIL/PASSWORD must be set per src/lib/env.ts:53)
NODEMAILER_PASSWORD="your_gmail_app_password"

# ── URLs (optional) ──────────────────────────────────────────────────
# Production URL — valid URL, optional (used as trustedOrigin & effectiveBaseUrl in src/lib/auth.ts:21 when NODE_ENV != development)
PRODUCTION_URL="https://yourdomain.com"
# Development URL — valid URL, optional, defaults to http://localhost:3000 in src/lib/env.ts:47
DEVELOPMENT_URL="http://localhost:3000"

# ── OAuth — GitHub (optional, set enabled: true in src/lib/auth.ts:43 if using) ─
# Empty string "" allowed as placeholder (transformed to undefined in src/lib/env.ts:32)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ── OAuth — Google (optional, set enabled: true in src/lib/auth.ts:47 if using) ─
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Node Environment (optional, defaults to development) ─────────────
# One of: development | production | test
NODE_ENV="development"
